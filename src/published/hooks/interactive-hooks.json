{
  "$schema": "interactive-hooks.schema.json",
  "contractVersion": "1.0",
  "bindings": [
    {
      "id": "record-active-release",
      "signal": "session.started",
      "action": "record-active-release",
      "destinations": ["canonical-state", "release-identity"],
      "persistedFields": ["release_identity"],
      "delivery": {"mode": "sync", "failure": "continue", "timeoutSeconds": null}
    },
    {
      "id": "append-session",
      "signal": "session.started",
      "action": "append-session",
      "destinations": ["canonical-state", "session-registry"],
      "persistedFields": ["session_id", "transcript_path", "cwd", "source", "timestamp", "harness_version"],
      "delivery": {"mode": "sync", "failure": "continue", "timeoutSeconds": null}
    },
    {
      "id": "remind-field-notes",
      "signal": "plan.completed",
      "action": "remind-field-notes",
      "destinations": ["human-log"],
      "persistedFields": [],
      "delivery": {"mode": "sync", "failure": "continue", "timeoutSeconds": null}
    },
    {
      "id": "append-file-change",
      "signal": "file.changed",
      "action": "append-file-change",
      "destinations": ["canonical-state", "human-log"],
      "persistedFields": ["timestamp", "family", "file_path"],
      "delivery": {"mode": "sync", "failure": "continue", "timeoutSeconds": null}
    },
    {
      "id": "append-dotnet-test-result",
      "signal": "dotnet-test.completed",
      "action": "append-dotnet-test-result",
      "destinations": ["canonical-state", "human-log"],
      "persistedFields": ["timestamp", "family", "result"],
      "delivery": {"mode": "sync", "failure": "continue", "timeoutSeconds": null}
    },
    {
      "id": "append-terraform-result",
      "signal": "terraform.completed",
      "action": "append-terraform-result",
      "destinations": ["canonical-state", "human-log"],
      "persistedFields": ["timestamp", "family", "terraform_subcommand", "result"],
      "delivery": {"mode": "sync", "failure": "continue", "timeoutSeconds": null}
    }
  ]
}
